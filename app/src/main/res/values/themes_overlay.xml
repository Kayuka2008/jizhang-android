        <item name="colorSurfaceVariant">@color/pal_purple_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/pal_purple_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/pal_purple_surface_lowest</item>
